# OCI Configuration
OCI_CONFIG=/root/oracle-freetier-instance-creation-main/oci_config
OCT_FREE_AD=AD-1
DISPLAY_NAME=vps-wiran-my-id
# The other free shape is AMD: VM.Standard.E2.1.Micro
OCI_COMPUTE_SHAPE=VM.Standard.A1.Flex
SECOND_MICRO_INSTANCE=False
REQUEST_WAIT_TIME_SECS=60
SSH_AUTHORIZED_KEYS_FILE=/root/oracle-freetier-instance-creation-main/id_rsa.pub
# SUBNET_ID to use ONLY in case running in local or a non E2.1.Micro instance 
OCI_SUBNET_ID=ocid1.subnet.oc1.ap-batam-1.aaaaaaaaqyv4ykkvzhj5yxsn2zwiwv575ap5ij7mvivpm2osoimbq4e3yfya
OCI_IMAGE_ID=
# The following will be ignored if OCI_IMAGE_ID is specified
OPERATING_SYSTEM="Canonical Ubuntu"
OS_VERSION=24.04
ASSIGN_PUBLIC_IP=true
# Boot volume size in GB (minimum is 50)
BOOT_VOLUME_SIZE=200

# Gmail Notification
NOTIFY_EMAIL=False
EMAIL=abc@gmail
EMAIL_PASSWORD=16characterswithoutspaces

# Discord Notification (optional)
DISCORD_WEBHOOK=
